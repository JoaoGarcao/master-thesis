@entry{verifx,
  name = {VeriFx},
  description = {A language and tool for the automated, SMT-based verification of replicated data types, generating convergence proofs, verified automatically by the Z3 solver.}
}

@entry{why3,
  name = {Why3},
  description = {A platform for deductive program verification, generating proof obligations from WhyML specifications and handing them to a choice of external provers.}
}

@entry{whyml,
  name = {WhyML},
  description = {The programming and specification language used by Why3, combining executable code with contracts, invariants, and ghost code.}
}

@entry{z3,
  name = {Z3},
  description = {An SMT solver used as VeriFx's sole solver and as one of Why3's external provers.}
}

@entry{alt-ergo,
  name = {Alt-Ergo},
  description = {An SMT solver used as one of Why3's external provers.}
}

